# Copy to .env and fill in real values. NEVER commit .env (see .gitignore).
# All variables use the OSPOS_ prefix.

# Database
OSPOS_DATABASE_URL=postgresql+psycopg://ospos:ospos@localhost:5432/ospos

# Auth (JWT) — generate a strong secret for production
OSPOS_JWT_SECRET=change-me-in-production
OSPOS_JWT_ALGORITHM=HS256
OSPOS_ACCESS_TOKEN_EXPIRE_MINUTES=30
OSPOS_REFRESH_TOKEN_EXPIRE_DAYS=7

# Login lockout
OSPOS_LOGIN_MAX_ATTEMPTS=5
OSPOS_LOGIN_LOCKOUT_MINUTES=15
